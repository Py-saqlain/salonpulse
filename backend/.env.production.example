# Deployment template only. These public example domains must be replaced.
# Never overwrite the existing local .env or commit real credentials.
APP_NAME="SalonPulse API"
APP_ENV=production
DEBUG=false
HTTPS_ONLY=true
DOCS_ENABLED=false
CORS_ORIGINS=["https://salon.example"]
TRUSTED_HOSTS=["api.salon.example"]
# Set only verified proxy addresses/CIDRs. Empty means no forwarded headers trusted.
TRUSTED_PROXIES=[]
JWT_ISSUER=https://api.salon.example
JWT_AUDIENCE=salonpulse-web
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Provision privately through the deployment secret manager or ignored .env.
# URL must use postgresql+psycopg, a dedicated non-admin login, strong independent
# password, and sslmode=verify-full with a valid CA/hostname certificate chain.
DATABASE_URL=
# Generate at least 32 cryptographically random bytes. No example signing key.
JWT_SECRET_KEY=

LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
REGISTRATION_RATE_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_CLIENTS=10000
AUTH_MAX_BODY_BYTES=16384
