# Copy to backend/.env for local overrides. Never commit real credentials.
APP_NAME="SalonPulse API"
APP_ENV=development
DEBUG=false

# Optional and unused in this task. Leave blank until those integrations exist.
# DATABASE_URL=<future database connection string>
# JWT_SECRET_KEY=<future securely provisioned secret>
DATABASE_URL=
JWT_SECRET_KEY=

# JSON array of exact origins. No trailing slash, paths or wildcard.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
