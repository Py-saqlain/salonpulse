# Copy to backend/.env for local overrides. Never commit real credentials.
APP_NAME="SalonPulse API"
APP_ENV=development
DEBUG=false

# Enter a real URL only in your private backend/.env. Percent-encode password
# characters such as @, :, /, # and %. Never paste credentials into chat or logs.
# DATABASE_URL=postgresql+psycopg://salonpulse_app:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/salonpulse_dev
# Leave blank to start without a database; /health/db then returns HTTP 503.
DATABASE_URL=

# Generate at least 32 random bytes privately; see backend/README.md.
# Leave blank for health/docs only; auth endpoints then return HTTP 503.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON array of exact origins. No trailing slash, paths or wildcard.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local defaults. Production/staging require explicit deployment hosts and HTTPS.
TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]","testserver"]
TRUSTED_PROXIES=[]
HTTPS_ONLY=false
DOCS_ENABLED=true
# Issuer/audience are required for production/staging; optional locally.
JWT_ISSUER=
JWT_AUDIENCE=

# Empty limits use environment defaults: development 120/min login and 60/hour
# registration; production/staging 10/min login and 5/hour registration.
LOGIN_RATE_LIMIT=
REGISTRATION_RATE_LIMIT=
LOGIN_RATE_WINDOW_SECONDS=60
REGISTRATION_RATE_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_CLIENTS=10000
AUTH_MAX_BODY_BYTES=16384
